# Anthropic API key — only used by the local CLI quality-gate (`npm run audit`).
# Production users supply their own (BYOK); the server never sees a stored key.
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Web Analytics token (optional in dev).
# Get it from Cloudflare dashboard → Analytics → Web Analytics → Add a site.
# Leave empty in development to skip the beacon.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
